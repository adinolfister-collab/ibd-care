{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "therapy_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendTherapyReminders"
          },
          "then": "end",
          "x-base44": {
            "title": "Invia promemoria terapie",
            "description": "Notifiche push ai farmaci in scadenza"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Rome",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Ogni 5 minuti invia notifiche push per i farmaci/integratori attivi il cui orario ricade nella finestra corrente (fuso Europe/Rome)",
  "name": "Promemoria terapie"
}