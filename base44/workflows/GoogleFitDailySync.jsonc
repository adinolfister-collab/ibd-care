{
  "name": "Sincronizzazione Google Fit",
  "description": "Ogni giorno alle 07:00 (Europe/Rome) sincronizza passi, calorie spese, distanza e peso di tutti gli utenti con Google Fit collegato.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "Europe/Rome",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "google_fit_daily_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncGoogleFitData",
            "args": {
              "all_users": true,
              "days": 3
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizza dati Google Fit",
            "description": "Importa passi, calorie e peso di tutti gli utenti connessi"
          }
        }
      }
    ]
  }
}