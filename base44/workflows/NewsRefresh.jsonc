{
  "name": "IBD News Refresh",
  "description": "Ogni giorno alle 6:00 aggiorna la cache delle notizie IBD pertinenti e recenti per tutte le lingue supportate",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "Europe/Rome",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ibd_news_refresh",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "refresh": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "refreshIBDNewsCache"
          },
          "then": "end",
          "x-base44": {
            "title": "Aggiorna cache notizie IBD",
            "description": "Ricerca web, controllo pertinenza IBD e refresh per ogni lingua"
          }
        }
      }
    ]
  }
}