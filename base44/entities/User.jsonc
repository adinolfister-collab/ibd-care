{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "subscription_status": {
      "type": "string",
      "description": "Synced Stripe subscription access level",
      "enum": [
        "none",
        "trialing",
        "active",
        "past_due",
        "canceled"
      ]
    },
    "subscription_trial_end": {
      "type": "string",
      "format": "date-time"
    },
    "subscription_period_end": {
      "type": "string",
      "format": "date-time"
    },
    "subscription_cancel_at_period_end": {
      "type": "boolean"
    },
    "promo_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Inizio della prova gratuita in-app di 1 mese per i moduli premium"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}