{
  "name": "FoodCatalogItem",
  "type": "object",
  "properties": {
    "category": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Descrizione opzionale dell'alimento"
    },
    "default_unit": {
      "type": "string",
      "enum": [
        "g",
        "ml",
        "porzione",
        "cucchiaio",
        "tazza",
        "fetta"
      ]
    },
    "kcal": {
      "type": "number",
      "description": "Calorie per 100 g (o 100 ml) di alimento"
    },
    "proteine": {
      "type": "number",
      "description": "Proteine (g) per 100 g (o 100 ml) di alimento"
    },
    "order": {
      "type": "number"
    }
  },
  "required": [
    "category",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}