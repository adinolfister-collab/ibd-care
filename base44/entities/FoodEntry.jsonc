{
  "name": "FoodEntry",
  "type": "object",
  "properties": {
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "meal_type": {
      "type": "string",
      "enum": [
        "colazione",
        "pranzo",
        "cena",
        "spuntino"
      ]
    },
    "foods": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "enum": [
              "g",
              "ml",
              "porzione",
              "cucchiaio",
              "tazza",
              "fetta"
            ]
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "reaction": {
      "type": "string",
      "enum": [
        "nessuna",
        "lieve",
        "moderata",
        "severa"
      ]
    },
    "tolerated": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "entry_date"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}