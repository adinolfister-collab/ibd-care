{
  "name": "CampaignSignup",
  "type": "object",
  "properties": {
    "campaign": {
      "type": "string",
      "enum": [
        "founders"
      ],
      "default": "founders"
    },
    "slot_type": {
      "type": "string",
      "enum": [
        "lifetime",
        "three_months"
      ]
    },
    "rank": {
      "type": "number"
    },
    "confirmed": {
      "type": "boolean",
      "default": false
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Descrizione opzionale dell'iscrizione alla campagna",
      "maxLength": 1000
    },
    "first_message_date": {
      "type": "string",
      "format": "date-time"
    },
    "referral_count": {
      "type": "number",
      "default": 0,
      "description": "Numero di iscritti giunti tramite il link di referral personale di questo founder"
    }
  },
  "required": [
    "campaign"
  ],
  "rls": {
    "read": {},
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}