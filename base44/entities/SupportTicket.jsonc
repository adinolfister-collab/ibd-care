{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "subject": {
      "type": "string",
      "description": "Oggetto breve del ticket (facoltativo)"
    },
    "message": {
      "type": "string",
      "description": "Testo del messaggio dell'utente"
    },
    "email": {
      "type": "string",
      "description": "Email del mittente (sempre presente, anche per ospiti non autenticati)"
    },
    "name": {
      "type": "string",
      "description": "Nome del mittente"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open",
      "description": "open = in attesa di risposta, closed = risposto"
    },
    "reply": {
      "type": "string",
      "description": "Risposta dell'admin"
    },
    "replied_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": [
        "contact",
        "account"
      ],
      "default": "contact",
      "description": "Origine del ticket: contact (form Contatti) o account (sezione Le mie richieste)"
    }
  },
  "required": [
    "message",
    "email",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}