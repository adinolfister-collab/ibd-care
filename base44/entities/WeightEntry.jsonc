{
  "name": "WeightEntry",
  "type": "object",
  "properties": {
    "entry_date": {
      "type": "string",
      "format": "date",
      "description": "Data di rilevazione del peso (YYYY-MM-DD)"
    },
    "weight_kg": {
      "type": "number",
      "description": "Peso in chilogrammi"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "googlefit"
      ],
      "default": "manual",
      "description": "Origine del dato: manual (inserito dall'utente) o googlefit (sincronizzato)"
    }
  },
  "required": [
    "entry_date",
    "weight_kg"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}