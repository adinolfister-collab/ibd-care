{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "integratori_nutraceutici",
        "alimenti_speciali",
        "presidi_medici_stomia"
      ]
    },
    "supplier": {
      "type": "string"
    },
    "supplier_url": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "price_indicativo": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "order": {
      "type": "number"
    }
  },
  "required": [
    "name",
    "category",
    "supplier",
    "supplier_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}